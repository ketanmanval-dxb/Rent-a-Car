# DriveEasy environment variables.
# Copy to .env.local for local development and fill in values. Never commit real values.
# Everything here is server-side only. Do NOT prefix secrets with NEXT_PUBLIC_.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL of the app (http://localhost:3000 locally)
APP_URL=

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# Local: postgres://driveeasy:<password>@localhost:5432/driveeasy_dev
# Vercel + Neon: DATABASE_URL = pooled connection string (app requests)
# ---------------------------------------------------------------------------
DATABASE_URL=
# Direct (non-pooled) connection used only for migrations. Neon provides this.
DATABASE_URL_UNPOOLED=
# Separate database for automated tests (local: driveeasy_test)
TEST_DATABASE_URL=
# Local superuser password (local machine admin only; not used by the app or on Vercel)
POSTGRES_SUPERUSER_PASSWORD=

# ---------------------------------------------------------------------------
# Authentication (Better Auth, email + password)
# ---------------------------------------------------------------------------
# 32+ random bytes, e.g. `openssl rand -hex 32`
BETTER_AUTH_SECRET=
# Same as APP_URL in most setups
BETTER_AUTH_URL=

# ---------------------------------------------------------------------------
# Payments
# PAYMENT_PROVIDER: fake (local test-mode stand-in) | stripe (future, test mode first)
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=
# -- fake provider --
FAKE_PAYMENT_WEBHOOK_SECRET=
FAKE_PAYMENT_WEBHOOK_URL=
FAKE_PAYMENT_STATE_FILE=
# Number of times each webhook is delivered (2+ simulates duplicates)
FAKE_PAYMENT_WEBHOOK_DELIVERIES=
# -- real provider (future) --
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
# Publishable key is safe for the browser; only if the provider's checkout UI needs it
NEXT_PUBLIC_PAYMENT_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# File storage (vehicle photos, driving licences, damage reports)
# STORAGE_PROVIDER: local (private folder outside /public) | vercel-blob (future)
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=
LOCAL_UPLOADS_DIR=
# Vercel Blob read/write token (future)
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Scheduled jobs (release expired holds)
# SCHEDULER_PROVIDER: local (`pnpm cron`) | vercel-cron (future, via vercel.json)
# ---------------------------------------------------------------------------
SCHEDULER_PROVIDER=
# Bearer token required by /api/cron/* routes (Vercel Cron sends it automatically)
CRON_SECRET=
# How long a reservation hold lasts before it expires
HOLD_EXPIRY_MINUTES=

# ---------------------------------------------------------------------------
# Testing
# ---------------------------------------------------------------------------
# Run Playwright against an already running or deployed URL instead of `pnpm dev`
PLAYWRIGHT_BASE_URL=
